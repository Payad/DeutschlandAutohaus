<% for (let i = 0; i < cart.products.length; i++) {
    let product = cart.products[i];
%>

<div class="cart-items"> 
  <div class="cart-row">
            <div class="cart-item cart-column">
            
                <img class="blackMug Mugs cart-item-image" id="cartItemImg" src="/assets/images/<%=product.image%>" alt="">
                <span class="cart-item-title"><%= product.name %></span>
            </div>
           
            <div class="cart-quantity cart-column">  
            <span class="cart-item-price">$ <%= product.price / 100%> </span>
              <button class="decrease" id="decrement" name="quantityInput" > - </button>
              <input type="number" id="quantity" class="cart-quantity-input" name="quantityInput" value="<%= product.quantity %>">
              <button  class="increase" name="quantityInput" onclick="increase3()">+</button>

<form action="/delete-cart" method="POST">
                <input type="hidden" name="prodId" class="cart-item-id" value="<%=product.id%>">
                <button class="btn btn-danger" type="submit">REMOVE</button>
</form>
            </div>
        </div>
</div>
 



<%}%>

<div class="cart-total">
<form action="/delete-all" method="POST">
  <button class="rmvAll btn btn-danger" type="submit">REMOVE ALL</button>
</form> 
  
 
<form action="/create-checkout-session" method="POST">  
<button type="button" class="btn btn-purchase" id="checkout-button">CHECKOUT</button>
</form>
