 <h1>Hello Welcome to the vehicle registration page</h1>
 <h2>Please enter your vehicles information</h2>


<h3>Select your vehicle and plan</h3>

<!-- If the user has a pending plan -->
<% if (currentUser.pending_plan) { %>
    <p>You are currently waiting for an inspection to finalize your <strong><%= currentUser.pending_plan %></strong> plan.</p>
<% } else { %>
    <p>No pending upgrades. You can select your service plan now!</p>
<% } %>

<form action="/schedule-inspection" method="POST">
    <input type="hidden" name="userId" value="<%= currentUser._id %>">
    <button type="submit" class="cta-button">Schedule Inspection</button>
</form>

