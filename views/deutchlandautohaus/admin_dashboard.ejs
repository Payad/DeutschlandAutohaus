<script>
document.querySelectorAll('.approval_btn').forEach(btn => {
 console.log('Attaching click handler to:', btn);  // Debugging if event is attached
  btn.addEventListener('click', function (e) {
    e.preventDefault();

    const form = this.closest('form');
    const userId = form.querySelector('[name="userId"]').value;

    const tierSel  = document.getElementById(`tier-${userId}`);
    const planSel  = document.getElementById(`plan-${userId}`);
    const hiddenTier = document.getElementById(`hiddenTier-${userId}`);
    const hiddenPlan = document.getElementById(`hiddenPlan-${userId}`);

    console.log('--- approve clicked ---');
    console.log({ userId, tierSel, planSel, hiddenTier, hiddenPlan });

    if (tierSel && hiddenTier) {
      hiddenTier.value = tierSel.value;
      console.log('tier copied →', hiddenTier.value);
    } else {
      console.warn('tier not found for', userId);
    }

    if (planSel && hiddenPlan) {
      hiddenPlan.value = planSel.value;
      console.log('plan copied →', hiddenPlan.value);
    } else {
      console.warn('plan not found for', userId);
    }

    // quick visual check
    // alert(`Submitting ${userId}\nTier: ${hiddenTier.value}\nPlan: ${hiddenPlan.value}`);

    form.submit();
  });
});
</script>
