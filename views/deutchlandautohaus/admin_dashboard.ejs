<script>
document.addEventListener('DOMContentLoaded', () => {
  const TWO_MINUTES = 2 * 60 * 1000;

  document.querySelectorAll('[data-status-changed-at]').forEach(el => {
    const changedAt = new Date(el.dataset.statusChangedAt);
    const now = new Date();
    const diff = now - changedAt;

    if (diff >= TWO_MINUTES) {
      const row = el.closest('tr');
      if (!row) return;

      // Disable Approve/Reject
      row.querySelectorAll('.approval_btn, .reject_btn').forEach(btn => {
        btn.disabled = true;
      });

      // Enable Review if exists
      const reviewBtn = row.querySelector('.reopen_btn');
      if (reviewBtn) reviewBtn.disabled = false;
    }
  });
});
</script>
